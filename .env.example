# Deployer wallet private key (no 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Optimism Mainnet RPC URL (e.g. from Alchemy or Infura)
OP_MAINNET_RPC_URL=https://mainnet.optimism.io

# Optimistic Etherscan API key for contract verification
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimistic_etherscan_api_key_here

# Initial owner/admin address for deployed contracts
INITIAL_OWNER=0xYourWalletAddress
